@startuml editing
' Who enters and changes transactions by hand, see README.md in this package.

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName sans-serif
top to bottom direction

database "Database\n(transactions, templates, payees, tags)" as db

package "ui_next (shell)" {
  [MainActivity\nplus button] as main
  [TransactionDetailSheet\nquick changes, form] as sheet
  [TransactionEditorActivity] as activity
  [widgets, shortcuts,\nscreens of :myExpenses] as entries
  [NewTransactionForReceipt] as receipt
  [TemplatesActivity\nNextTemplateScreens] as templatesActivity
  [RepositoryTemplateStore] as templateStoreImpl
  [RepositoryTransactionStore] as store
  [AnalysisCategorySuggestions] as suggestionsImpl
  [TagsFeature.TagField] as tagField
}

package "feature.transactions" {
  [TransactionEditorFlow] as flow
  [TemplatesFlow] as templatesFlow
  [TemplatesViewModel] as templatesVm
  [TransactionForm] as form
  [TransactionEditViewModel] as vm
}

package "data.transactions" {
  [TransactionDraft\nEditValues] as draft
  interface TransactionStore
  interface TemplateStore
  [Templates\nTemplateValues] as templateRules
  interface CategorySuggestions
}

package "data.categories" {
  [CategoryRepository\nCategoryAnalysis.suggestFor] as categories
}

main --> activity : newTransactionIntent
entries --> activity : TransactionEditorEntry
receipt --> activity : newTransactionIntent
templatesActivity --> templatesFlow
templatesFlow --> activity : fromTemplate
templatesFlow --> form
templatesFlow --> templatesVm
templatesFlow --> vm : template draft
templatesVm --> TemplateStore
vm --> TemplateStore
vm --> templateRules
templateStoreImpl ..|> TemplateStore
templateStoreImpl --> db
activity --> flow
flow --> form
sheet --> form
form ..> tagField : slot
flow --> vm
sheet --> vm
vm --> draft : toValues
vm --> TransactionStore
vm --> CategorySuggestions
store ..|> TransactionStore
suggestionsImpl ..|> CategorySuggestions
suggestionsImpl --> categories
store --> db
@enduml
