@startuml setup
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

package "ledger" {
  artifact Ledger
}
package "categories" {
  [CategoryRepository] as categoryRepository
  database "CategoryStore\n(rules, rule for cash,\nunclear)" as categoryStore
  [CategorySuggester] as suggester
}
package "cash" {
  [CashRepository] as cashRepository
  database "CashStore\n(cash account, since)" as cashStore
}
package "contracts (optional)" {
  artifact "SetupContracts\n(contracts, incomes,\nfrom NextData)" as setupContracts
}

package "setup" {
  [categoryQueue()] as queueFn
  artifact "CategoryQueue\n(coverage, required,\noptional, cash)" as queue
  [automaticShare()] as shareFn
  artifact AutomaticShare as share
  [SetupRepository] as repository
  artifact "SetupDecision\n(Categorized, Assigned,\nUnclear, Cash, Later)" as decision
  database "SetupStore\n(steps, pace,\ncard on the overview)" as store
  artifact "Pace" as pace
  [offer()] as offerFn
  artifact SetupOffer as offer
}

Ledger --> queueFn
categoryStore --> queueFn : unclear payees
cashStore --> queueFn : since, withdrawals\nleft out
queueFn --> queue
Ledger --> shareFn
categoryStore --> shareFn : rules
suggester --> shareFn : certain?
shareFn --> share
repository --> queueFn : Memo
repository --> shareFn : Memo
repository --> categoryRepository : categorize, assign,\ncategorize cash,\nmark unclear, take back
repository --> cashRepository : open cash account,\ntake back
repository --> decision
cashRepository --> cashStore
Ledger --> cashRepository : withdrawals\nto move
categoryRepository --> categoryStore
setupContracts --> repository : steps:\nincome, contracts
store --> repository : progress
store --> pace
store --> offerFn : reminder
offerFn --> offer

@enduml
