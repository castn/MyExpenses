<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The apps that can take a photo, which the settings offer as camera app -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application tools:ignore="MissingApplicationIcon">
        <!-- The main screen. The launcher starts it through SplashActivity of :myExpenses. -->
        <activity
            android:name="org.totschnig.myexpenses.next.MainActivity"
            android:launchMode="singleTop" />
        <activity
            android:name="org.totschnig.myexpenses.next.settings.NextSettings"
            android:label="@string/settings_label" />
        <activity android:name="org.totschnig.myexpenses.next.onboarding.NextOnboarding" />
        <activity
            android:name="org.totschnig.myexpenses.next.transactions.TransactionEditorActivity"
            android:parentActivityName="org.totschnig.myexpenses.next.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="org.totschnig.myexpenses.next.transactions.TemplatesActivity"
            android:parentActivityName="org.totschnig.myexpenses.next.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="org.totschnig.myexpenses.next.portfolio.TradeEditorActivity"
            android:parentActivityName="org.totschnig.myexpenses.next.MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
