@startuml modules
' Generated by the task moduleGraph of build-logic (ModuleGraphPlugin), do not edit.
' Dependencies between the modules of the new UI, rule `mod-diagram` of ARCHITECTURE.md.
' An edge that follows from a longer path is left out.
' An edge from or to a package stands for an edge from or to every module in it.
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam ranksep 80
top to bottom direction

[:charts] as mCharts
[:designsystem] as mDesignsystem
[:myExpenses\n(app)] as mMyExpenses
[:ui_next\n(dynamic feature)] as mUiNext

package "next/core" as pNextCore {
    [:common] as mNextCoreCommon
    [:model\n(Kotlin JVM)] as mNextCoreModel
    [:ui] as mNextCoreUi
}

package "next/data" as pNextData {
    [:analysis] as mNextDataAnalysis
    [:balance] as mNextDataBalance
    [:budgets] as mNextDataBudgets
    [:categories] as mNextDataCategories
    [:contracts] as mNextDataContracts
    [:guidance] as mNextDataGuidance
    [:merchants] as mNextDataMerchants
    [:tags] as mNextDataTags
    [:tips] as mNextDataTips
}

package "next/feature" as pNextFeature {
    [:analysis] as mNextFeatureAnalysis
    [:balance] as mNextFeatureBalance
    [:budgets] as mNextFeatureBudgets
    [:categories] as mNextFeatureCategories
    [:contracts] as mNextFeatureContracts
    [:guidance] as mNextFeatureGuidance
    [:merchants] as mNextFeatureMerchants
    [:tags] as mNextFeatureTags
    [:tips] as mNextFeatureTips
}

' Layout only
mNextDataMerchants -[hidden]--> pNextCore
mNextFeatureTips -[hidden]--> pNextData

mUiNext --> pNextFeature
pNextFeature --> mNextCoreUi
mNextCoreCommon --> mNextCoreModel
mNextCoreUi --> mDesignsystem
mNextCoreUi --> mNextCoreCommon
mNextDataAnalysis --> mNextDataTags
mNextDataBalance --> mNextDataContracts
mNextDataBudgets --> mNextDataBalance
mNextDataBudgets --> mNextDataTags
mNextDataCategories --> mNextDataMerchants
mNextDataContracts --> mNextDataMerchants
mNextDataGuidance --> mNextDataTips
mNextDataMerchants --> mNextCoreCommon
mNextDataTags --> mNextDataCategories
mNextDataTags --> mNextDataContracts
mNextDataTips --> mNextDataBudgets
mNextFeatureAnalysis --> mCharts
mNextFeatureAnalysis --> mNextDataAnalysis
mNextFeatureAnalysis --> mNextDataGuidance
mNextFeatureBalance --> mNextDataBalance
mNextFeatureBudgets --> mCharts
mNextFeatureBudgets --> mNextDataBudgets
mNextFeatureCategories --> mNextDataCategories
mNextFeatureContracts --> mNextDataContracts
mNextFeatureGuidance --> mNextDataGuidance
mNextFeatureMerchants --> mNextDataMerchants
mNextFeatureTags --> mNextDataTags
mNextFeatureTips --> mNextDataTips
mUiNext --> mMyExpenses
@enduml
