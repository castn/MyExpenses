<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds trust only system CAs. WebDAV with a self-signed or private CA
         certificate pins it in its own trust manager, which this config does not affect. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
